[Unit]
Description=WhatsNotify
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=whatsnotify
Group=whatsnotify
WorkingDirectory=/opt/WhatsNotify
Environment=NODE_ENV=production
Environment=HOME=/var/lib/whatsnotify
EnvironmentFile=/etc/whatsnotify/whatsnotify.env
ExecStart=/usr/bin/env node /opt/WhatsNotify/index.js
Restart=always
RestartSec=15
TimeoutStartSec=150
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/whatsnotify
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=whatsnotify

[Install]
WantedBy=multi-user.target
