[Unit]
Description=WhatsNotify safe auto-update check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/WhatsNotify
EnvironmentFile=/etc/whatsnotify/whatsnotify.env
ExecStart=/opt/WhatsNotify/whatsnotify.sh auto
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
