# Core
NODE_ENV=production
TZ=America/Sao_Paulo
APP_DIR=/opt/WhatsNotify
DATA_DIR=/var/lib/whatsnotify
WHATSAPP_AUTH_DIR=/var/lib/whatsnotify/sessions
WWEB_CACHE_DIR=/var/lib/whatsnotify/web-cache
PUPPETEER_CACHE_DIR=/var/lib/whatsnotify/puppeteer-cache
UPDATE_STATE_FILE=/var/lib/whatsnotify/update-state.json

# WhatsApp
SOURCE_CHAT_ID=
TARGET_GROUP_ID=
WHATSAPP_SESSION_ID=proditec-forwarder
WWEB_VERSION=
FORWARD_RETRIES=3
RETRY_DELAY_MS=3000
DEDUP_TTL_MS=86400000
READY_TIMEOUT_MS=120000

# SOAP automation
SOAP_ENABLED=true
SOAP_ENDPOINT=http://192.168.0.11/suporte/ServerSGPS.exe/soap/IServerSGPS
SOAP_CRON="0 7 * * *"
SOAP_TIMEZONE=America/Sao_Paulo
SOAP_TIMEOUT_MS=10000
SOAP_RETRIES=3
SOAP_RETRY_DELAY_MS=3000
SOAP_RUN_ON_START=false

# NTP monitor only; the system clock remains host-managed in LXC
NTP_SERVERS=a.ntp.br,b.ntp.br,c.ntp.br
NTP_INTERVAL_MS=1800000
NTP_TIMEOUT_MS=3000
NTP_DEGRADED_OFFSET_MS=1000

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DASHBOARD_ALLOW_UPDATE=false

# Git update
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_INTERVAL=300
AUTO_UPDATE_BRANCH=main
AUTO_UPDATE_REMOTE=origin
UPDATE_HEALTH_URL=http://127.0.0.1:8080/api/health
UPDATE_HEALTH_ATTEMPTS=30
UPDATE_HEALTH_DELAY=2
